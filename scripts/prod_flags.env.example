# Recommended production runtime baseline for Derived FTE + Velocity model
# Apply as environment variables in Azure App Service / container runtime.

TCO_VELOCITY_SNAPSHOT_AUTO_REFRESH=0
TCO_VELOCITY_ALLOW_STALE_SNAPSHOT=1

TCO_PROJECTED_DEMAND_SNAPSHOT_ENABLED=1
TCO_PROJECTED_DEMAND_SNAPSHOT_AUTO_REFRESH=0
TCO_PROJECTED_DEMAND_SNAPSHOT_STRICT_SCOPE=1
TCO_PROJECTED_VELOCITY_FAILOPEN_TO_SWAG=1

TCO_EXPLORER_VELOCITY_FROM_SNAPSHOT=1
TCO_COST_QUERY_CIRCUIT_SECONDS=30
TCO_WELCOME_INLINE_FIDELITY=0
TCO_DQ_LIGHT_FILTER_OPTIONS=1
TCO_ROADMAP_INCLUDE_ADO_TEAM_OPTIONS=0

# Roadmap advisory signal thresholds (Vel/Trend/Conf/Burn).
# Vel arrow compares PI velocity to reference:
# up if >= ref * UP_RATIO, down if <= ref * DOWN_RATIO, otherwise stable.
TCO_ROADMAP_SIGNAL_VEL_REF=65
TCO_ROADMAP_SIGNAL_VEL_UP_RATIO=1.15
TCO_ROADMAP_SIGNAL_VEL_DOWN_RATIO=0.90

# Trend classification thresholds.
TCO_ROADMAP_SIGNAL_TREND_DOWN=-0.20
TCO_ROADMAP_SIGNAL_TREND_UP=0.20
TCO_ROADMAP_SIGNAL_TREND_VOLATILE_CV=0.45
TCO_ROADMAP_SIGNAL_TREND_STABLE_CV=0.25

# Confidence score bands.
TCO_ROADMAP_SIGNAL_CONF_HIGH_MIN=75
TCO_ROADMAP_SIGNAL_CONF_MEDIUM_MIN=55

# Burn risk utilization thresholds (next 2 PI envelope).
TCO_ROADMAP_SIGNAL_BURN_HIGH_UTIL=1.10
TCO_ROADMAP_SIGNAL_BURN_TIGHT_UTIL=0.95
TCO_ROADMAP_SIGNAL_BURN_MEDIUM_UTIL=0.90

TCO_REFRESH_SNAPSHOTS_AFTER_ADO_SYNC=1
TCO_REFRESH_SNAPSHOTS_AFTER_OFFLINE_REBUILD=1
